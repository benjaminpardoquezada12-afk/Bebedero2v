<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bebedero_iot"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2D343C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wi_fi_online"
            android:textColor="#28A745"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!---Medicion del agua-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F9FB"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nivel_de_agua_actual"
            android:textSize="12sp"
            android:textColor="#737D87"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvNivelCm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_15_2_cm"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#2D343C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nivel_medio"
                android:textColor="#FF044B"
                android:background="#E8F4FE"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="16dp"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lleno_14_0_cm_vacio_17_0_cm"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!--Control de Bomba -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F9FB"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/control_de_actuador"
            android:textSize="12sp"
            android:textColor="#737D87"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstadoMotor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motor_12v_apagada"
            android:textColor="#DC3545"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEncender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/encender_bomba"
            android:backgroundTint="#28A745"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnApagar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apagar_bomba"
            android:backgroundTint="#DC3545"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/btnIrHistorial"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#00E676"
            android:text="@string/ver_historial_de_consumo"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>